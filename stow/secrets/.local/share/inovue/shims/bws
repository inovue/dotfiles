#!/bin/sh
# Human convenience: `bws ...` works without BWS_ACCESS_TOKEN in the shell env.
# The token is read from $BWS_ACCESS_TOKEN_FILE per call and exported only to
# this bws process. Claude Code denies `bws secret` / `bws run` via managed permissions.
token_file="${BWS_ACCESS_TOKEN_FILE:-$HOME/.config/inovue/bws-token}"
if [ -z "${BWS_ACCESS_TOKEN:-}" ] && [ -r "$token_file" ]; then
  BWS_ACCESS_TOKEN="$(tr -d '[:space:]' <"$token_file")"
  export BWS_ACCESS_TOKEN
fi
exec /usr/local/bin/bws "$@"
