#!/usr/bin/env bash
# Run a command with only the named Bitwarden Secrets Manager secrets in its env.
#
#   with-secrets FAL_KEY -- genmedia ...
#   with-secrets FAL_KEY,OPENROUTER_API_KEY -- uv run script.py
#   with-secrets --check FAL_KEY          # "FAL_KEY: ok" / "missing" (never prints values)
#   with-secrets --list                   # secret key names visible to the token
#
# - The bws access token is read from $BWS_ACCESS_TOKEN_FILE (default
#   ~/.config/inovue/bws-token) and is NOT passed to the command.
# - Keys already set in the environment win (per-project .env / direnv overrides).
# - Optional: BWS_PROJECT_ID limits lookups to one project.
set -euo pipefail

TOKEN_FILE="${BWS_ACCESS_TOKEN_FILE:-$HOME/.config/inovue/bws-token}"
SHIM_DIR="$HOME/.local/share/inovue/shims"

die() { echo "with-secrets: $*" >&2; exit 2; }

usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

bws_token() {
  if [[ -n "${BWS_ACCESS_TOKEN:-}" ]]; then
    printf '%s' "$BWS_ACCESS_TOKEN"
    return
  fi
  [[ -r "$TOKEN_FILE" ]] || die "no token: $TOKEN_FILE missing (see docs/bws.md)"
  local t
  t="$(tr -d '[:space:]' <"$TOKEN_FILE")"
  [[ -n "$t" ]] || die "$TOKEN_FILE is empty"
  printf '%s' "$t"
}

bws_list() {
  command -v bws >/dev/null 2>&1 || die "bws not installed (./setup.sh --tags tools)"
  local args=(secret list)
  [[ -n "${BWS_PROJECT_ID:-}" ]] && args+=("$BWS_PROJECT_ID")
  BWS_ACCESS_TOKEN="$(bws_token)" command bws "${args[@]}" --output json
}

# Resolve $1 on PATH, skipping the shim dir so a shim that calls us does not
# recurse. PATH itself is left intact: nested tools still get their own shims.
resolve_cmd() {
  local name="$1" p
  if [[ "$name" == */* ]]; then printf '%s' "$name"; return; fi
  local IFS=:
  for p in $PATH; do
    [[ "$p" == "$SHIM_DIR" || -z "$p" ]] && continue
    if [[ -x "$p/$name" && ! -d "$p/$name" ]]; then printf '%s' "$p/$name"; return; fi
  done
  die "command not found: $name"
}

KEYS=()
MODE=run
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help) usage 0 ;;
    --list) MODE=list; shift ;;
    --check) MODE=check; shift ;;
    --) shift; break ;;
    -*) die "unknown option: $1" ;;
    *)
      IFS=, read -r -a parts <<<"$1"
      KEYS+=("${parts[@]}")
      shift
      ;;
  esac
done

case "$MODE" in
  list)
    bws_list | jq -r '.[].key' | sort -u
    exit 0
    ;;
  check)
    [[ ${#KEYS[@]} -gt 0 ]] || die "--check needs key names"
    json="$(bws_list)"
    rc=0
    for k in "${KEYS[@]}"; do
      if [[ -n "${!k:-}" ]]; then
        echo "$k: ok (from environment)"
      elif jq -e --arg k "$k" 'any(.[]; .key == $k)' <<<"$json" >/dev/null; then
        echo "$k: ok (bws)"
      else
        echo "$k: missing"; rc=1
      fi
    done
    exit "$rc"
    ;;
esac

[[ ${#KEYS[@]} -gt 0 ]] || usage 2
[[ $# -gt 0 ]] || die "missing command after --"

# Guard against the common accident of dumping the values into a terminal or
# an agent transcript. Not a sandbox: the command itself can still read its env.
case "$(basename -- "$1")" in
  env | printenv | set | export | declare | echo | printf | cat)
    die "refusing to run '$1' with secrets (use --check to test availability)"
    ;;
esac

missing=()
for k in "${KEYS[@]}"; do
  [[ "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || die "invalid key name: $k"
  [[ -n "${!k:-}" ]] || missing+=("$k")
done

if [[ ${#missing[@]} -gt 0 ]]; then
  json="$(bws_list)"
  for k in "${missing[@]}"; do
    v="$(jq -r --arg k "$k" '[.[] | select(.key == $k)] | if length == 1 then .[0].value else empty end' <<<"$json")"
    [[ -n "$v" ]] || die "secret '$k' not found (or not unique) in Bitwarden SM"
    export "$k=$v"
  done
  unset json v
fi

cmd="$(resolve_cmd "$1")"
shift
unset BWS_ACCESS_TOKEN
exec "$cmd" "$@"
