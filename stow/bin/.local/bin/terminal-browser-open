#!/usr/bin/env bash
# herdr Ctrl+B Shift+B → platform-specific TB open.
# WSL: WezTerm sibling (tb-split). Native: herdr plugin nested split.
set -euo pipefail
if command -v powershell.exe >/dev/null 2>&1; then
  exec tb-split "$@"
fi
exec herdr plugin action invoke open-split --plugin zenbu-labs.terminal-browser
