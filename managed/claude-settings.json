{
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh",
    "padding": 0
  },
  "permissions": {
    "deny": [
      "Read(~/.config/inovue/**)",
      "Edit(~/.config/inovue/**)",
      "Bash(bws secret *)",
      "Bash(bws run *)",
      "Bash(bws project *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  }
}
